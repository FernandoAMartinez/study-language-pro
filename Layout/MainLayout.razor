@inherits LayoutComponentBase
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="flex min-h-dvh bg-[#f4efe6] dark:bg-[#0e0c08] transition-colors duration-200">

    <!-- ── Desktop sidebar — light paper ──────────────────────────────────── -->
    <aside class="hidden md:flex md:flex-col md:w-[220px] bg-[#f4efe6] dark:bg-[#0e0c08] shrink-0 min-h-screen border-r border-[rgba(26,22,18,0.10)] dark:border-white/5">

        <!-- Brand -->
        <div class="px-6 py-7 border-b border-[rgba(26,22,18,0.08)] dark:border-white/5">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-[#b34234] flex items-center justify-center shrink-0">
                    <span class="text-[#f4efe6] font-bold text-lg leading-none" style="font-family:'Noto Serif JP',serif">学</span>
                </div>
                <div>
                    <p class="text-[#1a1612] dark:text-[#ede9f5] font-medium text-base leading-tight" style="font-family:'Cormorant Garamond',serif;font-style:italic">Nihongo</p>
                    <p class="text-[#8c8378] dark:text-[#6a6480] text-[9px] tracking-[0.18em] uppercase mt-0.5" style="font-family:'JetBrains Mono',monospace">diario</p>
                </div>
            </div>
        </div>

        <!-- Section label -->
        <div class="px-6 pt-6 pb-2">
            <p class="text-[#8c8378] dark:text-[#6a6480] text-[9px] tracking-[0.18em] uppercase" style="font-family:'JetBrains Mono',monospace">Estudiar</p>
        </div>

        <!-- Nav links -->
        <NavMenu />

        <!-- Dark mode toggle -->
        <div class="px-4 pb-6 mt-auto border-t border-[rgba(26,22,18,0.06)] dark:border-white/5 pt-4">
            <button @onclick="ToggleTheme"
                class="flex items-center gap-2 w-full px-2 py-2 text-[#8c8378] dark:text-[#6a6480] hover:text-[#5a5048] dark:hover:text-[#9590A8] transition-colors text-xs">
                @if (_isDark)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.12em">MODO CLARO</span>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
                    <span style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.12em">MODO OSCURO</span>
                }
            </button>
        </div>
    </aside>

    <!-- ── Main content area ────────────────────────────────────────────────── -->
    <div class="flex flex-col flex-1 min-w-0">

        <!-- Mobile top header -->
        <header class="md:hidden sticky top-0 z-40 flex items-center justify-between px-5 py-3.5 bg-[#f4efe6] dark:bg-[#0e0c08] border-b border-[rgba(26,22,18,0.10)] dark:border-white/5">
            <div class="flex items-center gap-2.5">
                <div class="w-6 h-6 bg-[#b34234] flex items-center justify-center shrink-0">
                    <span class="text-[#f4efe6] font-bold text-xs" style="font-family:'Noto Serif JP',serif">学</span>
                </div>
                <span class="text-[#1a1612] dark:text-[#ede9f5] font-medium text-sm" style="font-family:'Cormorant Garamond',serif;font-style:italic">nihongo.diario</span>
            </div>
            <button @onclick="ToggleTheme"
                class="p-1.5 text-[#8c8378] hover:text-[#5a5048] transition-colors">
                @if (_isDark)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
                }
            </button>
        </header>

        <!-- Page content -->
        <main class="flex-1 px-5 pt-6 pb-28 md:px-10 md:py-8">
            @Body
        </main>
    </div>

    <!-- ── Mobile bottom navigation — paperDeep ──────────────────────────── -->
    <nav class="fixed bottom-0 inset-x-0 md:hidden bg-[#ebe4d6] dark:bg-[#0e0c08] border-t border-[rgba(26,22,18,0.10)] dark:border-white/5 flex justify-around items-center z-50"
         style="height: calc(58px + env(safe-area-inset-bottom, 0px)); padding-bottom: env(safe-area-inset-bottom, 0px)">

        <NavLink href="" Match="NavLinkMatch.All" class="mobile-nav-link" ActiveClass="mobile-nav-active">
            <span class="nav-kanji text-[22px] leading-none" style="font-family:'Noto Serif JP',serif">語</span>
            <span>Léxico</span>
        </NavLink>

        <NavLink href="flashcards" class="mobile-nav-link" ActiveClass="mobile-nav-active">
            <span class="nav-kanji text-[22px] leading-none" style="font-family:'Noto Serif JP',serif">札</span>
            <span>Tarjetas</span>
        </NavLink>

        <NavLink href="stats" class="mobile-nav-link" ActiveClass="mobile-nav-active">
            <span class="nav-kanji text-[22px] leading-none" style="font-family:'Noto Serif JP',serif">統</span>
            <span>Stats</span>
        </NavLink>

    </nav>
</div>

@code {
    private bool _isDark;
    private DotNetObjectReference<MainLayout>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDark = await JS.InvokeAsync<bool>("themeManager.isDark");
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pwaInstall.init", _selfRef);
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("themeManager.setTheme", _isDark ? "dark" : "light");
    }

    [JSInvokable]
    public void OnInstallAvailable() => StateHasChanged();

    [JSInvokable]
    public void OnAppInstalled() => StateHasChanged();

    public async ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        await ValueTask.CompletedTask;
    }
}
