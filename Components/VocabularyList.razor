@using study_language_pro.Models

@{
    var tags = Entries.SelectMany(e => e.Tags).Distinct().OrderBy(t => t).ToList();
    var displayed = string.IsNullOrEmpty(_selectedTag)
        ? Entries
        : Entries.Where(e => e.Tags.Contains(_selectedTag)).ToList();
}

<!-- Toolbar: filter + view toggle -->
<div class="flex items-center gap-2 mb-4 flex-wrap">
    @if (tags.Any())
    {
        <label class="text-xs text-[#6B6480] dark:text-[#9590A8] font-semibold shrink-0 uppercase tracking-wide">Etiqueta:</label>
        <select @onchange="OnTagFilterChange"
            class="text-sm border border-[#E5E2EC] dark:border-white/10 rounded-xl px-3 py-1.5 text-[#1A1523] dark:text-[#EDE9F5] focus:outline-none focus:ring-2 focus:ring-[#E8402A]/30 bg-white dark:bg-[#211E35] font-medium">
            <option value="">Todas (@Entries.Count)</option>
            @foreach (var tag in tags)
            {
                var count = Entries.Count(e => e.Tags.Contains(tag));
                <option value="@tag">@tag (@count)</option>
            }
        </select>
    }
    <div class="ml-auto flex gap-1">
        <button @onclick='() => _viewMode = "list"'
            class="@(_viewMode == "list" ? "bg-[#E8402A]/10 text-[#E8402A] dark:bg-[#E8402A]/15 dark:text-[#FF6B54]" : "text-[#B5B0BE] dark:text-[#6A6480] hover:text-[#6B6480] dark:hover:text-[#9590A8] hover:bg-[#F3F0EC] dark:hover:bg-[#211E35]") p-1.5 rounded-lg transition-colors"
            title="Vista lista">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
        </button>
        <button @onclick='() => _viewMode = "grid"'
            class="@(_viewMode == "grid" ? "bg-[#E8402A]/10 text-[#E8402A] dark:bg-[#E8402A]/15 dark:text-[#FF6B54]" : "text-[#B5B0BE] dark:text-[#6A6480] hover:text-[#6B6480] dark:hover:text-[#9590A8] hover:bg-[#F3F0EC] dark:hover:bg-[#211E35]") p-1.5 rounded-lg transition-colors"
            title="Vista grilla">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
            </svg>
        </button>
    </div>
</div>

@if (!displayed.Any())
{
    <div class="flex flex-col items-center justify-center py-20 gap-4">
        <div class="w-20 h-20 rounded-3xl bg-[#F3F0EC] dark:bg-[#211E35] flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 text-[#C5C0CE] dark:text-[#5A5470]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0118 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
        </div>
        <p class="text-sm font-semibold text-[#1A1523] dark:text-[#EDE9F5]">Sin palabras aún</p>
        <p class="text-xs text-[#6B6480] dark:text-[#9590A8]">Agregá tu primera entrada de vocabulario arriba.</p>
    </div>
}
else if (_viewMode == "list")
{
    <div class="grid gap-2.5">
        @foreach (var entry in displayed)
        {
            <div class="bg-white dark:bg-[#19182A] rounded-2xl shadow-[0_2px_16px_rgba(0,0,0,0.06)] dark:shadow-[0_2px_16px_rgba(0,0,0,0.35)] p-4 flex items-start gap-4">
                <div class="flex-1 min-w-0">
                    <!-- Primary line: Kanji + Kana + Romaji -->
                    <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-2 flex-wrap mb-1">
                        @if (!string.IsNullOrEmpty(entry.Kanji))
                        {
                            <span class="font-bold text-[#1A1523] dark:text-[#EDE9F5] text-xl leading-tight" style="font-family:'Noto Serif JP',serif">@entry.Kanji</span>
                        }
                        @if (!string.IsNullOrEmpty(entry.Kana))
                        {
                            <span class="text-[#6B6480] dark:text-[#9590A8] text-sm">@entry.Kana</span>
                        }
                        <span class="text-[#B5B0BE] dark:text-[#6A6480] text-sm italic">@entry.Romaji</span>
                    </div>
                    <!-- Significado -->
                    <p class="text-[#1A1523] dark:text-[#C8C2D8] text-sm font-semibold">@entry.Significado</p>
                    <!-- Ejemplo -->
                    @if (!string.IsNullOrWhiteSpace(entry.Ejemplo))
                    {
                        <p class="text-xs text-[#B5B0BE] dark:text-[#6A6480] mt-1 truncate italic">@entry.Ejemplo</p>
                    }
                    <!-- Tipo + Tags -->
                    @if (!string.IsNullOrEmpty(entry.TipoPalabra) || entry.Tags.Any())
                    {
                        <div class="flex flex-wrap gap-1.5 mt-2">
                            @if (!string.IsNullOrEmpty(entry.TipoPalabra))
                            {
                                <span class="bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-400 text-[11px] font-bold px-2 py-0.5 rounded-full border border-amber-200/70 dark:border-amber-800/50 tracking-wide uppercase">@entry.TipoPalabra</span>
                            }
                            @foreach (var tag in entry.Tags)
                            {
                                <span class="bg-[#E8402A]/8 dark:bg-[#E8402A]/12 text-[#E8402A] dark:text-[#FF6B54] text-[11px] font-semibold px-2 py-0.5 rounded-full">@tag</span>
                            }
                        </div>
                    }
                </div>
                <div class="flex gap-1.5 shrink-0 mt-0.5">
                    <button @onclick="() => OnEdit.InvokeAsync(entry)"
                        class="p-2 rounded-xl text-[#C5C0CE] dark:text-[#5A5470] hover:text-[#E8402A] dark:hover:text-[#FF6B54] hover:bg-[#E8402A]/8 dark:hover:bg-[#E8402A]/12 transition-colors"
                        title="Editar">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                    </button>
                    <button @onclick="() => OnDelete.InvokeAsync(entry.Id)"
                        class="p-2 rounded-xl text-[#C5C0CE] dark:text-[#5A5470] hover:text-red-500 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/40 transition-colors"
                        title="Eliminar">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                    </button>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Grid view -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
        @foreach (var entry in displayed)
        {
            <div class="bg-white dark:bg-[#19182A] rounded-2xl shadow-[0_2px_16px_rgba(0,0,0,0.06)] dark:shadow-[0_2px_16px_rgba(0,0,0,0.35)] p-4 flex flex-col gap-2">
                <div class="flex items-start gap-3">
                    <div class="flex-1 min-w-0">
                        @if (!string.IsNullOrEmpty(entry.Kanji))
                        {
                            <p class="text-2xl font-bold text-[#1A1523] dark:text-[#EDE9F5] leading-tight" style="font-family:'Noto Serif JP',serif">@entry.Kanji</p>
                            @if (!string.IsNullOrEmpty(entry.Kana))
                            {
                                <p class="text-sm text-[#6B6480] dark:text-[#9590A8]">@entry.Kana</p>
                            }
                            <p class="text-xs text-[#B5B0BE] dark:text-[#6A6480] italic">@entry.Romaji</p>
                        }
                        else if (!string.IsNullOrEmpty(entry.Kana))
                        {
                            <p class="text-xl font-bold text-[#1A1523] dark:text-[#EDE9F5] leading-tight">@entry.Kana</p>
                            <p class="text-xs text-[#B5B0BE] dark:text-[#6A6480] italic">@entry.Romaji</p>
                        }
                        else
                        {
                            <p class="text-xl font-bold text-[#6B6480] dark:text-[#9590A8] italic leading-tight">@entry.Romaji</p>
                        }
                    </div>
                    <div class="shrink-0 max-w-[45%] text-right">
                        <p class="text-sm font-bold text-[#E8402A] dark:text-[#FF6B54] leading-snug">@entry.Significado</p>
                    </div>
                </div>
                <div class="flex items-center justify-between gap-1 flex-wrap">
                    <div class="flex flex-wrap gap-1">
                        @if (!string.IsNullOrEmpty(entry.TipoPalabra))
                        {
                            <span class="bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-400 text-[11px] font-bold px-2 py-0.5 rounded-full border border-amber-200/70 dark:border-amber-800/50 uppercase tracking-wide">@entry.TipoPalabra</span>
                        }
                        @foreach (var tag in entry.Tags)
                        {
                            <span class="bg-[#E8402A]/8 dark:bg-[#E8402A]/12 text-[#E8402A] dark:text-[#FF6B54] text-[11px] font-semibold px-2 py-0.5 rounded-full">@tag</span>
                        }
                    </div>
                    <div class="flex gap-1 shrink-0 ml-auto">
                        <button @onclick="() => OnEdit.InvokeAsync(entry)"
                            class="p-1.5 rounded-lg text-[#C5C0CE] dark:text-[#5A5470] hover:text-[#E8402A] dark:hover:text-[#FF6B54] hover:bg-[#E8402A]/8 dark:hover:bg-[#E8402A]/12 transition-colors"
                            title="Editar">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                        </button>
                        <button @onclick="() => OnDelete.InvokeAsync(entry.Id)"
                            class="p-1.5 rounded-lg text-[#C5C0CE] dark:text-[#5A5470] hover:text-red-500 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/40 transition-colors"
                            title="Eliminar">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<VocabularyEntry> Entries { get; set; } = [];
    [Parameter] public EventCallback<VocabularyEntry> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }

    private string _selectedTag = string.Empty;
    private string _viewMode = "list";

    private void OnTagFilterChange(ChangeEventArgs e)
    {
        _selectedTag = e.Value?.ToString() ?? string.Empty;
    }
}
