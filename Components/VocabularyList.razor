@using study_language_pro.Models
@inject IJSRuntime JS

@{
    var allTipos = Entries.Select(e => e.TipoPalabra).Where(t => !string.IsNullOrEmpty(t)).Distinct().OrderBy(t => t).ToList();
    var displayed = _selectedFilter switch
    {
        "__nuevas__" => Entries.Where(e => e.CreatedAt >= DateTime.UtcNow.AddDays(-7)).ToList(),
        "__todas__"  => Entries.ToList(),
        var t when !string.IsNullOrEmpty(t) => Entries.Where(e => e.TipoPalabra == t).ToList(),
        _            => Entries.ToList()
    };
    var nuevasCount = Entries.Count(e => e.CreatedAt >= DateTime.UtcNow.AddDays(-7));
}

<!-- Filter pills -->
<div class="flex gap-2 py-4 flex-wrap">
    @{
        var filters = new List<(string Key, string Label, int Count)>
        {
            ("__todas__", "Todas", Entries.Count)
        };
        foreach (var tipo in allTipos)
            filters.Add((tipo, tipo, Entries.Count(e => e.TipoPalabra == tipo)));
        if (nuevasCount > 0)
            filters.Add(("__nuevas__", "Nuevas", nuevasCount));
    }
    @foreach (var (key, label, count) in filters)
    {
        var k = key;
        bool active = _selectedFilter == k;
        <button @onclick="() => _selectedFilter = k"
            class="px-3 py-1 text-[11px] border transition-colors @(active ? "bg-[#1a1612] dark:bg-[#ede9f5] border-[#1a1612] dark:border-[#ede9f5] text-[#f4efe6] dark:text-[#1a1612]" : "border-[rgba(26,22,18,0.18)] dark:border-white/15 text-[#5a5048] dark:text-[#9590A8] hover:border-[rgba(26,22,18,0.35)] dark:hover:border-white/30")"
            style="border-radius:999px">
            @label · @count
        </button>
    }
</div>

@if (!displayed.Any())
{
    <div class="flex flex-col items-center justify-center py-24 gap-3">
        <p class="text-[#8c8378] dark:text-[#6a6480] text-sm" style="font-family:'JetBrains Mono',monospace">sin entradas</p>
    </div>
}
else
{
    <!-- Column headers (desktop) -->
    <div class="hidden md:grid md:grid-cols-[1fr_1fr_auto] gap-4 px-0 pb-2 border-b border-[rgba(26,22,18,0.12)] dark:border-white/8">
        @foreach (var col in new[] { "Palabra", "Significado", "Nivel" })
        {
            <span class="text-[9px] text-[#8c8378] dark:text-[#6a6480] tracking-[0.16em] uppercase" style="font-family:'JetBrains Mono',monospace">@col</span>
        }
    </div>

    <div>
        @foreach (var entry in displayed)
        {
            <div class="flex items-center gap-4 py-4 border-b border-[rgba(26,22,18,0.06)] dark:border-white/5 group">
                <!-- Word -->
                <div class="flex-1 min-w-0">
                    <div class="mb-0.5">
                        @if (!string.IsNullOrEmpty(entry.Kanji))
                        {
                            <span class="text-xl font-medium text-[#1a1612] dark:text-[#ede9f5]" style="font-family:'Noto Serif JP',serif">@entry.Kanji</span>
                        }
                        @if (!string.IsNullOrEmpty(entry.Kana))
                        {
                            <span class="text-sm text-[#5a5048] dark:text-[#9590A8] ml-2">@entry.Kana</span>
                        }
                        @if (string.IsNullOrEmpty(entry.Kanji) && string.IsNullOrEmpty(entry.Kana))
                        {
                            <span class="text-lg font-medium text-[#1a1612] dark:text-[#ede9f5]" style="font-family:'Noto Serif JP',serif">@entry.Romaji</span>
                        }
                    </div>
                    <div class="flex items-baseline gap-3">
                        <span class="text-base text-[#1a1612] dark:text-[#ede9f5] italic" style="font-family:'Cormorant Garamond',serif">@entry.Significado</span>
                        @if (!string.IsNullOrEmpty(entry.Kanji) || !string.IsNullOrEmpty(entry.Kana))
                        {
                            <span class="text-[10px] text-[#8c8378] dark:text-[#6a6480] tracking-[0.04em]" style="font-family:'JetBrains Mono',monospace">@entry.Romaji</span>
                        }
                    </div>
                </div>
                <!-- Tags -->
                <div class="hidden md:flex items-center gap-1.5 shrink-0">
                    @foreach (var tag in entry.Tags.Take(2))
                    {
                        <span class="text-[9px] text-[#8c8378] dark:text-[#6a6480] tracking-[0.08em]" style="font-family:'JetBrains Mono',monospace">@tag</span>
                    }
                    @if (!string.IsNullOrEmpty(entry.TipoPalabra))
                    {
                        <span class="text-[9px] text-[#8c8378] dark:text-[#6a6480] tracking-[0.08em]" style="font-family:'JetBrains Mono',monospace">@entry.TipoPalabra</span>
                    }
                </div>
                <!-- Actions: always visible on mobile, fade-in on desktop hover -->
                <div class="flex items-center gap-0 shrink-0 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity">
                    <button @onclick="() => SpeakEntry(entry)" title="Escuchar"
                        class="p-1.5 text-[#8c8378] hover:text-[#1a1612] dark:hover:text-[#ede9f5] transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H2v6h4l5 4V5z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072" />
                        </svg>
                    </button>
                    <button @onclick="() => OnEdit.InvokeAsync(entry)" title="Editar"
                        class="p-1.5 text-[#8c8378] hover:text-[#1a1612] dark:hover:text-[#ede9f5] transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                    </button>
                    <button @onclick="() => OnDelete.InvokeAsync(entry.Id)" title="Eliminar"
                        class="p-1.5 text-[#8c8378] hover:text-[#b34234] transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<VocabularyEntry> Entries { get; set; } = [];
    [Parameter] public EventCallback<VocabularyEntry> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }

    private string _selectedFilter = "__todas__";

    private async Task SpeakEntry(VocabularyEntry entry)
    {
        var text = !string.IsNullOrEmpty(entry.Kana) ? entry.Kana : entry.Romaji;
        await JS.InvokeVoidAsync("ttsInterop.speak", text);
    }
}
