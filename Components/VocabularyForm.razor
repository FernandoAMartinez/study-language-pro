@using study_language_pro.Models

<div class="bg-[#f4efe6] dark:bg-[#0e0c08] p-6 border border-[rgba(26,22,18,0.15)] dark:border-white/8">
    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-[rgba(26,22,18,0.10)] dark:border-white/5">
        <div class="w-7 h-7 bg-[#b34234] flex items-center justify-center shrink-0">
            <span class="text-[#f4efe6] text-sm font-bold" style="font-family:'Noto Serif JP',serif">@(Entry is null ? "＋" : "編")</span>
        </div>
        <h2 class="text-lg text-[#1a1612] dark:text-[#ede9f5]" style="font-family:'Cormorant Garamond',serif;font-style:italic">
            @(Entry is null ? "Nueva palabra" : "Editar palabra")
        </h2>
    </div>

    <EditForm Model="_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="grid gap-5">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[9px] text-[#8c8378] dark:text-[#6a6480] mb-2 tracking-[0.18em] uppercase" style="font-family:'JetBrains Mono',monospace">漢字 Kanji</label>
                    <InputText @bind-Value="_model.Kanji" class="field-input" placeholder="ej. 私" />
                </div>
                <div>
                    <label class="block text-[9px] text-[#8c8378] dark:text-[#6a6480] mb-2 tracking-[0.18em] uppercase" style="font-family:'JetBrains Mono',monospace">かな Kana</label>
                    <InputText @bind-Value="_model.Kana" class="field-input" placeholder="ej. わたし" />
                </div>
            </div>

            <div>
                <label class="block text-[9px] text-[#8c8378] dark:text-[#6a6480] mb-2 tracking-[0.18em] uppercase" style="font-family:'JetBrains Mono',monospace">
                    Romaji <span class="text-[#b34234]">*</span>
                </label>
                <InputText @bind-Value="_model.Romaji" class="field-input" placeholder="ej. watashi" />
                @if (_showRomajiError) { <p class="text-xs text-[#b34234] mt-1">El Romaji es obligatorio.</p> }
            </div>

            <div>
                <label class="block text-[9px] text-[#8c8378] dark:text-[#6a6480] mb-2 tracking-[0.18em] uppercase" style="font-family:'JetBrains Mono',monospace">
                    Significado <span class="text-[#b34234]">*</span>
                </label>
                <InputText @bind-Value="_model.Significado" class="field-input" placeholder="ej. yo, yo mismo" />
                @if (_showSignificadoError) { <p class="text-xs text-[#b34234] mt-1">El Significado es obligatorio.</p> }
            </div>

            <div>
                <label class="block text-[9px] text-[#8c8378] dark:text-[#6a6480] mb-2 tracking-[0.18em] uppercase" style="font-family:'JetBrains Mono',monospace">Ejemplo de uso</label>
                <InputTextArea @bind-Value="_model.Ejemplo" rows="2" class="field-input resize-none" placeholder="ej. 私は学生です" />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[9px] text-[#8c8378] dark:text-[#6a6480] mb-2 tracking-[0.18em] uppercase" style="font-family:'JetBrains Mono',monospace">Tipo de palabra</label>
                    <InputSelect @bind-Value="_model.TipoPalabra" class="field-input">
                        <option value="">— sin especificar —</option>
                        <option value="sustantivo">Sustantivo</option>
                        <option value="verbo">Verbo</option>
                        <option value="adjetivo">Adjetivo</option>
                        <option value="adverbio">Adverbio</option>
                        <option value="partícula">Partícula</option>
                        <option value="expresión">Expresión</option>
                        <option value="otro">Otro</option>
                    </InputSelect>
                </div>
                <div>
                    <label class="block text-[9px] text-[#8c8378] dark:text-[#6a6480] mb-2 tracking-[0.18em] uppercase" style="font-family:'JetBrains Mono',monospace">Etiquetas</label>
                    <InputText @bind-Value="_tagsInput" class="field-input" placeholder="N5, pronombres…" />
                </div>
            </div>
        </div>

        <div class="flex gap-3 mt-7">
            <button type="submit"
                class="flex-1 py-3 px-4 bg-[#1a1612] dark:bg-[#ede9f5] text-[#f4efe6] dark:text-[#1a1612] text-sm hover:bg-[#5a5048] dark:hover:bg-white transition-colors" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;text-transform:uppercase">
                @(Entry is null ? "Añadir palabra" : "Guardar cambios")
            </button>
            @if (OnCancel.HasDelegate)
            {
                <button type="button" @onclick="OnCancel"
                    class="flex-1 py-3 px-4 border border-[rgba(26,22,18,0.18)] dark:border-white/15 text-[#5a5048] dark:text-[#9590A8] text-sm hover:bg-[rgba(26,22,18,0.05)] dark:hover:bg-white/5 transition-colors" style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;text-transform:uppercase">
                    Cancelar
                </button>
            }
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public VocabularyEntry? Entry { get; set; }
    [Parameter] public EventCallback<VocabularyEntry> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private VocabularyEntry _model = new();
    private string _tagsInput = string.Empty;
    private bool _showRomajiError;
    private bool _showSignificadoError;

    protected override void OnParametersSet()
    {
        if (Entry is not null)
        {
            _model = new VocabularyEntry
            {
                Id = Entry.Id, Kanji = Entry.Kanji, Kana = Entry.Kana,
                Romaji = Entry.Romaji, Significado = Entry.Significado,
                Ejemplo = Entry.Ejemplo, Tags = new List<string>(Entry.Tags),
                TipoPalabra = Entry.TipoPalabra, CreatedAt = Entry.CreatedAt
            };
            _tagsInput = string.Join(", ", Entry.Tags);
        }
        else { _model = new VocabularyEntry(); _tagsInput = string.Empty; }
        _showRomajiError = false;
        _showSignificadoError = false;
    }

    private async Task HandleSubmit()
    {
        _showRomajiError = string.IsNullOrWhiteSpace(_model.Romaji);
        _showSignificadoError = string.IsNullOrWhiteSpace(_model.Significado);
        if (_showRomajiError || _showSignificadoError) return;
        _model.Tags = _tagsInput.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        await OnSave.InvokeAsync(_model);
        _model = new VocabularyEntry();
        _tagsInput = string.Empty;
    }
}
