@page "/stats"
@using study_language_pro.Models
@inject ILocalStorageService Storage
@inject IJSRuntime JS

<PageTitle>Estadísticas — nihongo.diario</PageTitle>

<div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="flex items-end justify-between mb-0 pb-5 border-b border-[rgba(26,22,18,0.12)] dark:border-white/8">
        <div>
            <p class="text-[#8c8378] dark:text-[#6a6480] text-[10px] tracking-[0.18em] uppercase mb-2" style="font-family:'JetBrains Mono',monospace">統計 · estadísticas</p>
            <h1 class="text-[#1a1612] dark:text-[#ede9f5] leading-none" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:42px;font-weight:400">
                Tu progreso
            </h1>
        </div>
        <!-- Time filter -->
        <div class="flex gap-1 mb-1">
            @foreach (var (label, value) in new[] { ("7d", 7), ("30d", 30), ("12s", 84), ("todo", 0) })
            {
                var v = value;
                <button @onclick="() => _dayFilter = v"
                    class="px-2.5 py-1 text-[10px] border transition-colors @(_dayFilter == v ? "bg-[#1a1612] dark:bg-[#ede9f5] border-[#1a1612] dark:border-[#ede9f5] text-[#f4efe6] dark:text-[#1a1612]" : "border-[rgba(26,22,18,0.18)] dark:border-white/15 text-[#5a5048] dark:text-[#9590A8] hover:border-[rgba(26,22,18,0.35)]")"
                    style="font-family:'JetBrains Mono',monospace;letter-spacing:0.1em">
                    @label
                </button>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center py-16 text-[#8c8378] dark:text-[#6a6480] text-sm" style="font-family:'JetBrains Mono',monospace">cargando…</div>
    }
    else if (!_allSessions.Any())
    {
        <div class="py-16 text-center border-b border-[rgba(26,22,18,0.06)] dark:border-white/5">
            <p class="text-[#8c8378] dark:text-[#6a6480] text-sm mb-4" style="font-family:'JetBrains Mono',monospace">sin sesiones aún</p>
            <a href="flashcards" class="text-xs border border-[rgba(26,22,18,0.18)] dark:border-white/15 px-4 py-2 text-[#5a5048] dark:text-[#9590A8] hover:bg-[rgba(26,22,18,0.05)] dark:hover:bg-white/5 transition-colors" style="font-family:'JetBrains Mono',monospace;letter-spacing:0.06em">
                ir a tarjetas →
            </a>
        </div>
    }
    else
    {
            var cutoff = _dayFilter == 0 ? DateTime.MinValue : DateTime.UtcNow.AddDays(-_dayFilter);
            var sessions = _allSessions.Where(s => s.Date >= cutoff).ToList();
            var totalPracticed = sessions.Sum(s => s.TotalCards);
            var totalKnown = sessions.Sum(s => s.KnownCount);
            var hitRate = totalPracticed > 0 ? totalKnown * 100.0 / totalPracticed : 0;
            var streak = ComputeStreak(_allSessions);


        <!-- KPIs — 2 cols mobile / 4 cols desktop, border-top separators -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 mt-6 mb-8">
            @foreach (var (val, sub, accent) in new (string, string, bool)[]
            {
                (totalPracticed.ToString(), "palabras", false),
                ($"{streak}", "racha actual", true),
                ($"{hitRate:F0}%", "precisión", false),
                (sessions.Count.ToString(), "sesiones", false),
            })
            {
                <div class="pt-3 border-t border-[#1a1612] dark:border-[#ede9f5]">
                    <div class="flex items-baseline gap-1.5">
                        <span class="leading-none @(accent ? "text-[#b34234]" : "text-[#1a1612] dark:text-[#ede9f5]")" style="font-family:'Cormorant Garamond',serif;font-size:38px;font-weight:500">@val</span>
                        @if (accent && val != "0") { <span class="text-sm text-[#8c8378] italic" style="font-family:'Cormorant Garamond',serif">días</span> }
                    </div>
                    <p class="text-[9px] text-[#8c8378] dark:text-[#6a6480] tracking-[0.18em] uppercase mt-1" style="font-family:'JetBrains Mono',monospace">@sub</p>
                </div>
            }
        </div>

        <!-- Heatmap — full width, responsive SVG -->
        <div class="mb-6">
            <p class="text-[9px] text-[#8c8378] dark:text-[#6a6480] tracking-[0.16em] uppercase mb-3" style="font-family:'JetBrains Mono',monospace">Actividad — 12 semanas</p>
            @{
                var hmToday = DateTime.UtcNow.Date;
                var hmWeeks = 20;
                var hmStart = hmToday.AddDays(-(hmWeeks * 7 - 1));
                hmStart = hmStart.AddDays(-(int)hmStart.DayOfWeek);
                int hmCell = 14; int hmGap = 3;
                int hmStride = hmCell + hmGap;
                int hmLeft = 18; int hmTop = 16;
                var hmSvgW = hmLeft + hmWeeks * hmStride;
                var hmSvgH = hmTop + 7 * hmStride;
            }
            <div class="relative" @onmousemove="OnHeatmapMouseMove">
                <svg viewBox="0 0 @hmSvgW @hmSvgH" style="width:100%;height:auto;display:block" preserveAspectRatio="xMinYMid meet">
                    @{
                        var hmLabelColor = _isDark ? "#6a6480" : "#8c8378";
                    }
                    @((MarkupString)$"<text x=\"{hmLeft - 2}\" y=\"{hmTop + 1 * hmStride + hmCell - 2}\" text-anchor=\"end\" font-size=\"7\" fill=\"{hmLabelColor}\" font-family=\"JetBrains Mono,monospace\">L</text>")
                    @((MarkupString)$"<text x=\"{hmLeft - 2}\" y=\"{hmTop + 3 * hmStride + hmCell - 2}\" text-anchor=\"end\" font-size=\"7\" fill=\"{hmLabelColor}\" font-family=\"JetBrains Mono,monospace\">M</text>")
                    @((MarkupString)$"<text x=\"{hmLeft - 2}\" y=\"{hmTop + 5 * hmStride + hmCell - 2}\" text-anchor=\"end\" font-size=\"7\" fill=\"{hmLabelColor}\" font-family=\"JetBrains Mono,monospace\">V</text>")
                    @{
                        var hmInk = _isDark ? "237,233,245" : "26,22,18";
                    }
                    @for (int w = 0; w < hmWeeks; w++)
                    {
                        for (int d = 0; d < 7; d++)
                        {
                            var hmDate = hmStart.AddDays(w * 7 + d);
                            if (hmDate > hmToday) continue;
                            activityMap.TryGetValue(hmDate, out var hmAct);
                            var hmTotal = hmAct.TotalCards;
                            var opacity = hmTotal == 0 ? 0.07 : hmTotal <= 5 ? 0.22 : hmTotal <= 15 ? 0.45 : hmTotal <= 30 ? 0.68 : 0.92;
                            var hmCx = hmLeft + w * hmStride;
                            var hmCy = hmTop + d * hmStride;
                            var capturedDate = hmDate;
                            var capturedTotal = hmTotal;
                            <rect x="@hmCx" y="@hmCy" width="@hmCell" height="@hmCell"
                                  style="fill:rgba(@hmInk,@opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));cursor:default"
                                  @onmouseover="() => OnCellHover(capturedDate, capturedTotal)"
                                  @onmouseout="OnCellLeave" />
                        }
                    }
                </svg>
                @if (hoveredCell is not null)
                {
                    <div class="absolute bg-[#1a1612] text-[#f4efe6] text-[10px] px-3 py-1.5 pointer-events-none whitespace-nowrap z-10" style="left:@(mouseX + 8)px;top:@(mouseY - 36)px;font-family:'JetBrains Mono',monospace">
                        @hoveredCell.Value.Label
                    </div>
                }
            </div>
        </div>

        <!-- Chart — full width -->
        <div class="mb-6">
            <p class="text-[9px] text-[#8c8378] dark:text-[#6a6480] tracking-[0.16em] uppercase mb-3" style="font-family:'JetBrains Mono',monospace">Precisión por sesión</p>
            @((MarkupString)_chartSvg)
        </div>

        <!-- Hard words -->
        @if (_top5.Any())
        {
            <div class="border-t border-[rgba(26,22,18,0.12)] dark:border-white/8 pt-5 mb-6">
                <div class="flex justify-between items-baseline mb-4">
                    <p class="text-[9px] text-[#8c8378] dark:text-[#6a6480] tracking-[0.16em] uppercase" style="font-family:'JetBrains Mono',monospace">palabras que se te resisten</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-0">
                    @{int rank = 0;}
                    @foreach (var (wordId, count) in _top5.Take(3))
                    {
                        _wordMap.TryGetValue(wordId, out var entry);
                        <div class="flex justify-between items-center py-3 @(rank < 2 ? "border-b md:border-b-0 md:border-r" : "") border-[rgba(26,22,18,0.06)] dark:border-white/5 @(rank > 0 ? "md:px-5" : "md:pr-5")">
                            <div>
                                @if (entry is not null && !string.IsNullOrEmpty(entry.Kanji))
                                {
                                    <p class="text-lg font-medium text-[#1a1612] dark:text-[#ede9f5]" style="font-family:'Noto Serif JP',serif">@entry.Kanji</p>
                                }
                                <p class="text-sm italic text-[#5a5048] dark:text-[#9590A8]" style="font-family:'Cormorant Garamond',serif">@(entry?.Significado ?? wordId)</p>
                            </div>
                            <div class="text-right">
                                <p class="text-2xl text-[#b34234] leading-none" style="font-family:'Cormorant Garamond',serif;font-weight:500">@count</p>
                                <p class="text-[8px] text-[#8c8378] tracking-[0.12em] uppercase mt-0.5" style="font-family:'JetBrains Mono',monospace">fallos</p>
                            </div>
                        </div>
                        rank++;
                    }
                </div>
            </div>
        }

        <!-- Session history -->
        <div class="border-t border-[rgba(26,22,18,0.12)] dark:border-white/8 pt-5">
            <p class="text-[9px] text-[#8c8378] dark:text-[#6a6480] tracking-[0.16em] uppercase mb-4" style="font-family:'JetBrains Mono',monospace">Historial de sesiones</p>
            <div class="overflow-x-auto">
                <table class="w-full text-xs min-w-[480px]" style="font-family:'JetBrains Mono',monospace">
                    <thead>
                        <tr class="border-b border-[rgba(26,22,18,0.10)] dark:border-white/8">
                            @foreach (var h in new[] { "Fecha", "Total", "Lo sé", "Difícil", "Fallé", "Acierto" })
                            {
                                <th class="text-left pb-2 text-[8px] text-[#8c8378] dark:text-[#6a6480] tracking-[0.16em] uppercase font-normal @(h != "Fecha" ? "text-right" : "")">@h</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in sessions.OrderByDescending(s => s.Date).Take(15))
                        {
                            var rate = s.TotalCards > 0 ? s.KnownCount * 100.0 / s.TotalCards : 0;
                            <tr class="border-b border-[rgba(26,22,18,0.05)] dark:border-white/5">
                                <td class="py-2.5 text-[#8c8378] dark:text-[#6a6480] text-[10px]">@s.Date.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                                <td class="py-2.5 text-right text-[#1a1612] dark:text-[#ede9f5]">@s.TotalCards</td>
                                <td class="py-2.5 text-right text-[#1a1612] dark:text-[#ede9f5]">@s.KnownCount</td>
                                <td class="py-2.5 text-right text-[#8c8378] dark:text-[#6a6480]">@s.HardCount</td>
                                <td class="py-2.5 text-right text-[#b34234]">@s.ReviewCount</td>
                                <td class="py-2.5 text-right font-medium @(rate >= 80 ? "text-[#1a1612] dark:text-[#ede9f5]" : rate >= 50 ? "text-[#8c8378]" : "text-[#b34234]")">@rate.ToString("F0")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<StudySession> _allSessions = [];
    private Dictionary<string, VocabularyEntry> _wordMap = new();
    private List<(string Id, int Count)> _top5 = [];
    private bool _loading = true;
    private bool _isDark;
    private string _chartSvg = string.Empty;
    private Dictionary<DateTime, (int TotalCards, int KnownCount)> activityMap = new();
    private (string Label, DateTime Date)? hoveredCell = null;
    private int mouseX, mouseY;
    private int _dayFilter = 30;

    protected override async Task OnInitializedAsync()
    {
        _allSessions = await Storage.GetItemAsync<List<StudySession>>("study_sessions") ?? [];
        var entries = await Storage.GetItemAsync<List<VocabularyEntry>>("vocabulary_entries") ?? [];
        _wordMap = entries.ToDictionary(e => e.Id.ToString(), e => e);
        _top5 = _allSessions.SelectMany(s => s.ReviewedWordIds).GroupBy(id => id)
            .Select(g => (Id: g.Key, Count: g.Count())).OrderByDescending(x => x.Count).Take(5).ToList();
        var hmStart = DateTime.UtcNow.Date.AddDays(-363);
        activityMap = _allSessions.Where(s => s.Date.Date >= hmStart).GroupBy(s => s.Date.Date)
            .ToDictionary(g => g.Key, g => (TotalCards: g.Sum(s => s.TotalCards), KnownCount: g.Sum(s => s.KnownCount)));
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDark = await JS.InvokeAsync<bool>("themeManager.isDark");
            _chartSvg = BuildChartSvg(_allSessions, _isDark);
            StateHasChanged();
        }
    }

    private static string BuildChartSvg(List<StudySession> sessions, bool isDark)
    {
        var ic = System.Globalization.CultureInfo.InvariantCulture;
        var cs = sessions.OrderBy(s => s.Date).TakeLast(20).ToList();
        var cW = 460.0; var cH = 120.0; var cX0 = 0.0; var cY0 = 10.0;
        var gridColor = isDark ? "rgba(237,233,245,0.06)" : "rgba(26,22,18,0.06)";
        var labelColor = isDark ? "#6a6480" : "#8c8378";
        var lineColor = isDark ? "rgba(237,233,245,0.5)" : "rgba(26,22,18,0.5)";
        var pts = cs.Select((s, i) =>
        {
            var r = s.TotalCards > 0 ? s.KnownCount * 100.0 / s.TotalCards : 0;
            var x = cs.Count == 1 ? cX0 + cW / 2 : cX0 + i * cW / (cs.Count - 1);
            var y = cY0 + cH - r / 100.0 * cH;
            return (x, y, r);
        }).ToList();
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {(cX0+cW+16).ToString("F0",ic)} {(cY0+cH+8).ToString("F0",ic)}' style='width:100%;height:140px' aria-hidden='true'>");
        foreach (var pct in new[] { 0, 50, 100 })
        {
            var gy = (cY0 + cH - pct / 100.0 * cH).ToString("F1", ic);
            sb.Append($"<line x1='{cX0.ToString("F0",ic)}' y1='{gy}' x2='{(cX0+cW).ToString("F0",ic)}' y2='{gy}' stroke='{gridColor}' stroke-width='1'/>");
            sb.Append($"<text x='{(cX0+cW+4).ToString("F0",ic)}' y='{(double.Parse(gy,ic)+3).ToString("F1",ic)}' font-size='8' fill='{labelColor}' font-family='JetBrains Mono,monospace'>{pct}%</text>");
        }
        if (pts.Count > 1)
        {
            var line = string.Join(" ", pts.Select(p => p.x.ToString("F1", ic) + "," + p.y.ToString("F1", ic)));
            sb.Append($"<polyline points='{line}' fill='none' stroke='{lineColor}' stroke-width='1.5' stroke-linejoin='round' stroke-linecap='round'/>");
        }
        foreach (var (x, y, r) in pts)
        {
            var fill = r >= 80 ? "#1a1612" : r >= 50 ? "#8c8378" : "#b34234";
            if (isDark) fill = r >= 80 ? "#ede9f5" : r >= 50 ? "#8c8378" : "#b34234";
            sb.Append($"<circle cx='{x.ToString("F1",ic)}' cy='{y.ToString("F1",ic)}' r='3' fill='{fill}'/>");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }

    private static int ComputeStreak(List<StudySession> sessions)
    {
        if (!sessions.Any()) return 0;
        var days = sessions.Select(s => s.Date.ToLocalTime().Date).Distinct().OrderByDescending(d => d).ToList();
        var today = DateTime.Today;
        if (days[0] < today.AddDays(-1)) return 0;
        int streak = 1;
        for (int i = 1; i < days.Count; i++)
        {
            if ((days[i - 1] - days[i]).Days == 1) streak++;
            else break;
        }
        return streak;
    }

    private void OnCellHover(DateTime date, int total)
    {
        if (total == 0) return;
        hoveredCell = ($"{total} repaso{(total == 1 ? "" : "s")} · {date:dd MMM yy}", date);
    }
    private void OnCellLeave() => hoveredCell = null;
    private void OnHeatmapMouseMove(MouseEventArgs e) { mouseX = (int)e.OffsetX; mouseY = (int)e.OffsetY; }
}
