@page "/flashcards"
@inject ILocalStorageService Storage

<PageTitle>Tarjetas — nihongo.diario</PageTitle>

<div class="max-w-2xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-0 pb-5 border-b border-[rgba(26,22,18,0.12)] dark:border-white/8">
        <div>
            <p class="text-[#8c8378] dark:text-[#6a6480] text-[10px] tracking-[0.18em] uppercase mb-2" style="font-family:'JetBrains Mono',monospace">カード · tarjetas</p>
            <h1 class="text-[#1a1612] dark:text-[#ede9f5] leading-none" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(32px,8vw,42px);font-weight:400">
                Sesión de estudio
            </h1>
        </div>

        @if (_allTags.Any())
        {
            <div class="flex items-center gap-2 md:mb-1">
                <label class="text-[9px] text-[#8c8378] dark:text-[#6a6480] tracking-[0.18em] uppercase shrink-0" style="font-family:'JetBrains Mono',monospace">Mazo</label>
                <select @onchange="TagFilterChanged"
                    class="flex-1 md:flex-none text-xs border border-[rgba(26,22,18,0.18)] dark:border-white/10 px-2.5 py-1.5 text-[#1a1612] dark:text-[#ede9f5] focus:outline-none bg-transparent min-w-0" style="font-family:'JetBrains Mono',monospace;letter-spacing:0.04em">
                    <option value="">Todas (@_allEntries.Count)</option>
                    @foreach (var tag in _allTags)
                    {
                        var count = _allEntries.Count(e => e.Tags.Contains(tag));
                        <option value="@tag">@tag (@count)</option>
                    }
                </select>
            </div>
        }
    </div>

    <div class="pt-6">
        @if (_loading)
        {
            <div class="text-center py-16 text-[#8c8378] dark:text-[#6a6480] text-sm" style="font-family:'JetBrains Mono',monospace">cargando…</div>
        }
        else
        {
            <FlashcardSession Cards="_filteredEntries" />
        }
    </div>
</div>

@code {
    private List<VocabularyEntry> _allEntries = [];
    private IReadOnlyList<VocabularyEntry> _filteredEntries = [];
    private List<string> _allTags = [];
    private string _selectedTag = string.Empty;
    private bool _loading = true;

    private const string StorageKey = "vocabulary_entries";

    protected override async Task OnInitializedAsync()
    {
        _allEntries = await Storage.GetItemAsync<List<VocabularyEntry>>(StorageKey) ?? [];
        _allTags = _allEntries.SelectMany(e => e.Tags).Distinct().OrderBy(t => t).ToList();
        ApplyFilter();
        _loading = false;
    }

    private void TagFilterChanged(ChangeEventArgs e)
    {
        _selectedTag = e.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _filteredEntries = string.IsNullOrEmpty(_selectedTag)
            ? _allEntries
            : _allEntries.Where(e => e.Tags.Contains(_selectedTag)).ToList();
    }
}
